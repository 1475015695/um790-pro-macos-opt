+    NVMTLSurfaceKey *k = [NVMTLSurfaceKey new];
+    k->_sid = IOSurfaceGetID(surf); k->_plane = plane; k->_w = w; k->_h = h;
+    k->_fmt = (NSUInteger)fmt; k->_ropt = (NSUInteger)ropt; k->_fbo = fbo ? 1u : 0u;
+    uint64_t hv = nvmtl_mix64(((uint64_t)k->_sid << 32) | k->_w);
+    hv ^= nvmtl_mix64(((uint64_t)k->_h << 32) | ((uint64_t)k->_plane << 1) | k->_fbo);
+    hv ^= nvmtl_mix64((uint64_t)k->_fmt ^ ((uint64_t)k->_ropt << 20));
+    k->_hash = (NSUInteger)hv;
+    return k;
