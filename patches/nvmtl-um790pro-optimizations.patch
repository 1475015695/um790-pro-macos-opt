+static uint64_t check_vram_cap_forked(const char *prog, const char *env_val) {
+    int pfd[2];
+    assert(pipe(pfd) == 0);
+    pid_t pid = fork();
+    assert(pid >= 0);
+    if (pid == 0) {
+        close(pfd[0]);
+        g_prog = prog;
+        if (env_val) setenv("NVMTL_AMD_VRAM_CAP_MB", env_val, 1);
+        else unsetenv("NVMTL_AMD_VRAM_CAP_MB");
+        uint64_t cap = nvmtl_amd_vram_cap();
+        assert(write(pfd[1], &cap, sizeof(cap)) == sizeof(cap));
+        close(pfd[1]);
+        _exit(0);
+    }
+    close(pfd[1]);
+    uint64_t cap = 0;
+    assert(read(pfd[0], &cap, sizeof(cap)) == sizeof(cap));
+    close(pfd[0]);
+    int st = 0;
+    assert(waitpid(pid, &st, 0) == pid && WIFEXITED(st) && WEXITSTATUS(st) == 0);
+    return cap;
+}
+
+static int check_rp_light_forked(const char *prog, uint16_t vendor, const char *env_val) {
+    pid_t pid = fork();
