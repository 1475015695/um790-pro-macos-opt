+static void nvmtl_probe_host_vm(const void *ptr, size_t len, BOOL *outReadOnly, BOOL *outImmutable)
+{
+    if (outReadOnly) *outReadOnly = NO;
+    if (outImmutable) *outImmutable = NO;
+    if (!ptr || !len) return;
+    const mach_vm_address_t start = (mach_vm_address_t)(uintptr_t)ptr;
+    if (len > (size_t)(UINT64_MAX - start)) return;
+    const mach_vm_address_t end = start + (mach_vm_address_t)len;
+    BOOL anyRO = NO, allImm = YES;
+    mach_vm_address_t cur = start;
+    while (cur < end) {
+        mach_vm_address_t raddr = cur;
+        mach_vm_size_t rsize = 0;
+        vm_region_basic_info_data_64_t basic = {0};
+        mach_msg_type_number_t bcnt = VM_REGION_BASIC_INFO_COUNT_64;
+        mach_port_t obj = MACH_PORT_NULL;
+        kern_return_t kr = mach_vm_region(mach_task_self(), &raddr, &rsize, VM_REGION_BASIC_INFO_64,
+                                          (vm_region_info_t)&basic, &bcnt, &obj);
+        if (obj != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(), obj);
+        if (kr != KERN_SUCCESS || !rsize || raddr > cur || rsize > UINT64_MAX - raddr) { allImm = NO; break; }
+        const mach_vm_address_t rend = raddr + rsize;
+        if (rend <= cur) { allImm = NO; break; }
+
+        mach_vm_address_t xaddr = cur;
+        mach_vm_size_t xsize = 0;
+        vm_region_extended_info_data_t ext = {0};
+        mach_msg_type_number_t xcnt = VM_REGION_EXTENDED_INFO_COUNT;
+        obj = MACH_PORT_NULL;
+        kr = mach_vm_region(mach_task_self(), &xaddr, &xsize, VM_REGION_EXTENDED_INFO,
+                            (vm_region_info_t)&ext, &xcnt, &obj);
+        if (obj != MACH_PORT_NULL) mach_port_deallocate(mach_task_self(), obj);
+        const BOOL extOK = (kr == KERN_SUCCESS && xsize && xaddr <= cur && xsize <= UINT64_MAX - xaddr);
+        mach_vm_address_t next = rend;
+        if (extOK && xaddr + xsize < next) next = xaddr + xsize;
+        if (next <= cur) { allImm = NO; break; }
+
+        if (!(basic.protection & VM_PROT_WRITE)) anyRO = YES;
+        if ((basic.max_protection & VM_PROT_WRITE) || !extOK ||
+            (ext.share_mode != SM_COW && ext.share_mode != SM_PRIVATE)) {
+            allImm = NO;
+        }
+        cur = next;
+    }
+    if (outReadOnly) *outReadOnly = anyRO;
+    if (outImmutable) *outImmutable = anyRO && allImm;
+}
